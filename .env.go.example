# Export these values before running the Go commands. Existing Laravel .env is not read.
APP_ENV=development
APP_MODE=live
HTTP_ADDR=:8080
DB_DRIVER=postgres
DATABASE_URL=postgres://bgeo:bgeodevpass@127.0.0.1:54320/bgeo?sslmode=disable
SQLITE_PATH=data/geopilot.db
AUTO_MIGRATE=false
SEED_DEMO=false
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# openssl rand -base64 32 (required for persistent credentials; required in production)
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOW_LOCAL_OUTBOUND=true
WORKER_CONCURRENCY=4
PERPLEXITY_API_KEY=
COPILOT_API_KEY=
COPILOT_BASE_URL=https://api.deepseek.com/v1
COPILOT_MODEL=deepseek-chat

# 本地 Docker 基础设施 (make infra-up) 连接配置
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bgeo
